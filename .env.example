# CrowdGuard System Environment Variables
# Copy this file to .env and configure as needed

# ============================================================================
# Database Configuration
# ============================================================================

# Database connection URL
# Default: sqlite:///./crowdguard.db (SQLite database in current directory)
# For PostgreSQL: postgresql://user:password@localhost/crowdguard
# For MySQL: mysql://user:password@localhost/crowdguard
DATABASE_URL=sqlite:///./crowdguard.db


# ============================================================================
# Model Selection
# ============================================================================

# Set to 1 to use the fine-tuned VisDrone model (weights/crowdguard_visdrone.pt)
# Use this for processing drone/aerial footage — NOT for webcam
# Set to 0 (default) to use pretrained YOLOv8n COCO weights (best for webcam)
# Run 'bash train_model.sh' first to generate the VisDrone weights
CROWDGUARD_USE_VISDRONE=0


# ============================================================================
# Detection Configuration
# ============================================================================

# Minimum detection confidence score for YOLOv8 person detection
# Range: 0.3 to 0.9
# Default: 0.5
# Higher values reduce false positives but may miss some detections
CROWDGUARD_CONFIDENCE_THRESHOLD=0.5

# YOLOv8 model variant to use for person detection
# Options: nano, small, medium
# Default: nano
# - nano: Fastest, lowest accuracy (recommended for real-time)
# - small: Balanced speed and accuracy
# - medium: Slower, highest accuracy
CROWDGUARD_MODEL_VARIANT=nano


# ============================================================================
# Anomaly Detection Thresholds
# ============================================================================

# High density anomaly detection threshold
# Range: 0.5 to 0.9
# Default: 0.7
# Triggers HIGH_DENSITY alert when crowd density exceeds this value
CROWDGUARD_HIGH_DENSITY_THRESHOLD=0.7

# Rapid movement velocity threshold (pixels per frame)
# Default: 25
# Triggers RAPID_MOVEMENT alert when average velocity exceeds this value
CROWDGUARD_RAPID_MOVEMENT_THRESHOLD=25

# Crowd surge detection threshold (percentage increase)
# Range: 0.0 to 1.0
# Default: 0.3 (30% increase)
# Triggers CROWD_SURGE alert when person count increases by this percentage
CROWDGUARD_CROWD_SURGE_THRESHOLD=0.3

# Sudden dispersal detection threshold (percentage increase in spread)
# Range: 0.0 to 1.0
# Default: 0.4 (40% increase)
# Triggers SUDDEN_DISPERSAL alert when spatial spread increases by this percentage
CROWDGUARD_SUDDEN_DISPERSAL_THRESHOLD=0.4

# Stationary crowd density threshold
# Range: 0.0 to 1.0
# Default: 0.5
# Minimum density required for STATIONARY_CROWD detection
CROWDGUARD_STATIONARY_CROWD_THRESHOLD=0.5

# Stationary crowd velocity threshold (pixels per frame)
# Default: 3
# Maximum average velocity for STATIONARY_CROWD detection
CROWDGUARD_STATIONARY_VELOCITY_THRESHOLD=3

# Stationary crowd duration threshold (seconds)
# Default: 30
# Minimum duration for STATIONARY_CROWD alert
CROWDGUARD_STATIONARY_DURATION_SECONDS=30

# Fighting detection IoU threshold
# Range: 0.0 to 1.0
# Default: 0.3
# Minimum bounding box overlap for FIGHTING detection
CROWDGUARD_FIGHTING_IOU_THRESHOLD=0.3

# Fighting detection velocity threshold (pixels per frame)
# Default: 20
# Minimum local velocity for FIGHTING detection
CROWDGUARD_FIGHTING_VELOCITY_THRESHOLD=20


# ============================================================================
# Alert Configuration
# ============================================================================

# Alert cooldown period (seconds)
# Range: 5 to 60
# Default: 10
# Minimum time between duplicate alerts of the same type
CROWDGUARD_COOLDOWN_PERIOD_SECONDS=10


# ============================================================================
# Visualization Configuration
# ============================================================================

# Heatmap overlay opacity
# Range: 0.0 to 1.0
# Default: 0.6
# 0.0 = fully transparent, 1.0 = fully opaque
CROWDGUARD_HEATMAP_OPACITY=0.6


# ============================================================================
# Server Configuration
# ============================================================================

# Backend server host
# Default: 0.0.0.0 (listen on all interfaces)
SERVER_HOST=0.0.0.0

# Backend server port
# Default: 8000
SERVER_PORT=8000

# Enable debug mode (verbose logging)
# Default: false
DEBUG=false


# ============================================================================
# File Storage Configuration
# ============================================================================

# Directory for uploaded video files
# Default: ./uploads
UPLOAD_DIR=./uploads

# Directory for alert frame snapshots
# Default: ./snapshots
SNAPSHOT_DIR=./snapshots

# Directory for YOLOv8 model weights
# Default: ./weights
WEIGHTS_DIR=./weights


# ============================================================================
# Cleanup Configuration
# ============================================================================

# Alert snapshot retention period (days)
# Default: 30
# Snapshots older than this will be automatically deleted
SNAPSHOT_RETENTION_DAYS=30

# Density log retention period (days)
# Default: 7
# Density logs older than this will be automatically deleted
DENSITY_LOG_RETENTION_DAYS=7


# ============================================================================
# Performance Configuration
# ============================================================================

# Maximum WebSocket message queue size
# Default: 100
# Older frame messages are dropped when queue exceeds this size
WS_MAX_QUEUE_SIZE=100

# Target frames per second for video processing
# Default: 10
TARGET_FPS=10

# Heatmap update interval (seconds)
# Default: 2
# Heatmap is recalculated at this interval instead of every frame
HEATMAP_UPDATE_INTERVAL=2


# ============================================================================
# Security Configuration
# ============================================================================

# Maximum video file upload size (bytes)
# Default: 524288000 (500 MB)
MAX_UPLOAD_SIZE=524288000

# Allowed video file extensions (comma-separated)
# Default: mp4,avi,mov,mkv
ALLOWED_VIDEO_EXTENSIONS=mp4,avi,mov,mkv


# ============================================================================
# Logging Configuration
# ============================================================================

# Log level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# Log file path (optional)
# If not set, logs only to console
# LOG_FILE=./crowdguard.log
